  level: 9
  dialogueEntries:
  - speakerName: "\u0410\u0439\u043D\u0430"
    dialogueText: "\u041A\u0440\u044B\u043B\u044C\u044F \u0442\u044F\u0436\u0435\u043B\u0435\u044E\u0442\u2026
      \u041C\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u043C \u0438\u0445 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C, \u0443\u043B\u0435\u0442\u0430\u0439 \u043D\u0430
      \u044E\u0433, \u0442\u0430\u043C\u2026 \u0434\u043E\u043B\u0436\u043D\u043E
      \u0431\u044B\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0439\u2026"
    portrait: {fileID: 21300000, guid: 72c3baf0026623b4d9bca131e6639dff, type: 3}
  - speakerName: "\u0424\u0435\u0439"
    dialogueText: "\u041D\u043E \u043E\u043D\u0438 \u043F\u043E\u0432\u0441\u044E\u0434\u0443\u2026
      \u0411\u0443\u0434\u0435\u0442 \u043B\u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0439
      \u0445\u043E\u0442\u044C \u0433\u0434\u0435-\u0442\u043E \u0438\u043B\u0438
      \u043F\u043E\u0431\u0435\u0433 \u044D\u0442\u043E \u043B\u0438\u0448\u044C\u2026\r"
    portrait: {fileID: 21300000, guid: f11a159b6a870d849a8cc63879c49328, type: 3}
