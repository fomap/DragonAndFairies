  level: 2
  dialogueEntries:
  - speakerName: "\u0410\u0439\u043D\u0430"
    dialogueText: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043E\u043D\u0438
      \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u043B\u0438.
      \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435, \u0431\u044B\u0441\u0442\u0440\u044B\u0435,
      \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u0436\u0430\u0440\u043E\u043F\u0443\u0445.
      \u0414\u044B\u0448\u0430\u0442\u044C \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435,
      \u0430 \u0432\u0440\u043E\u0434\u0435 \u0442\u0430\u043A\u043E\u0439 \u043F\u0443\u0441\u0442\u044F\u043A."
    portrait: {fileID: 21300000, guid: 36094033f779eb141aab4de49e03239c, type: 3}
  - speakerName: "\u0424\u0435\u0439"
    dialogueText: "\u041F\u0443\u0441\u0442\u044F\u043A, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
      \u0430 \u043C\u044B \u0441\u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u043D\u0430 \u044D\u0442\u043E \u0442\u0440\u0430\u0442\u0438\u043C. \u041D\u043E
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E, \u0447\u0442\u043E \u043E\u043D\u0438
      \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442."
    portrait: {fileID: 21300000, guid: 532487dbf7d4ecf4092a7237f620493d, type: 3}
