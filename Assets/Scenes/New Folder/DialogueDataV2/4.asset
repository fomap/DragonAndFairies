  dialogueEntries:
  - speakerName: "\u0410\u0439\u043D\u0430"
    dialogueText: "\u0421 \u0432\u0435\u0440\u0448\u0438\u043D \u0432\u0438\u0434\u043D\u043E
      \u043D\u043E\u0432\u044B\u0435 \u043E\u0433\u043D\u0438. \u041A\u043E\u0441\u0442\u0440\u044B,
      \u0438\u0445 \u0431\u044B\u043B\u043E \u043C\u0430\u043B\u043E, \u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D\u0438 \u0438\u0434\u0443\u0442 \u043E\u0434\u0438\u043D \u0437\u0430
      \u0434\u0440\u0443\u0433\u0438\u043C \u0438 \u0442\u044F\u043D\u0443\u0442\u0441\u044F
      \u043A \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0443. \u041E\u043D\u0438
      \u0431\u0443\u0434\u0442\u043E \u043F\u0435\u0440\u0435\u0440\u0438\u0441\u043E\u0432\u044B\u0432\u0430\u044E\u0442
      \u0437\u0435\u043C\u043B\u044E \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443."
    portrait: {fileID: 21300000, guid: 72c3baf0026623b4d9bca131e6639dff, type: 3}
  - speakerName: "\u0424\u0435\u0439"
    dialogueText: "\u041B\u044E\u0434\u0438. \u0412\u0441\u0435\u0433\u0434\u0430
      \u0432\u0441\u0451 \u0434\u0435\u043B\u0430\u044E\u0442 \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443
      \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u0437\u0430
      \u0441\u043E\u0431\u043E\u0439 \u0441\u043B\u0435\u0434\u044B. \u0425\u043E\u0442\u044F
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0442\u0430\u043A \u043A\u0440\u0430\u0441\u0438\u0432\u043E\u2026\r\n"
    portrait: {fileID: 21300000, guid: 958eed8f4937fad41a2dcc551731e5f9, type: 3}
