  dialogueEntries:
  - speakerName: "\u0410\u0439\u043D\u0430"
    dialogueText: "\u0420\u044B\u0431\u044B \u0432 \u0440\u0435\u043A\u0430\u0445
      \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435. \u0422\u0443\u0442
      \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u0438\u0448\u0435. \u041E\u0442
      \u0432\u043E\u0434\u044B \u0432\u0441\u0451 \u0442\u0430\u043A-\u0436\u0435
      \u0442\u044F\u043D\u0435\u0442 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043E\u0439
      \u0438 \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044C\u044E, \u043D\u043E
      \u0442\u0438\u0448\u0438\u043D\u0430 \u043D\u0435\u043F\u0440\u0438\u0432\u044B\u0447\u043D\u0430.\r\n"
    portrait: {fileID: 21300000, guid: 72c3baf0026623b4d9bca131e6639dff, type: 3}
  - speakerName: "\u0424\u0435\u0439"
    dialogueText: "\u041C\u043E\u0436\u0435\u0442 \u043C\u0438\u0433\u0440\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u043A\u0443\u0434\u0430\u2026 \u0425\u043E\u0442\u044F \u0432 \u0442\u0430\u043A\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u044D\u0442\u043E \u0432\u0440\u044F\u0434
      \u043B\u0438. "
    portrait: {fileID: 21300000, guid: f11a159b6a870d849a8cc63879c49328, type: 3}
